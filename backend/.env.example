# Anthropic API key. Lives only on the server, never in the iOS app.
ANTHROPIC_API_KEY=

# Must match the iOS app's bundle ID (PRODUCT_BUNDLE_IDENTIFIER in ios/project.yml).
APPLE_BUNDLE_ID=com.example.cargpt

# Signs session tokens. Generate one with: openssl rand -base64 48
SESSION_SECRET=

PORT=8787
CHAT_REQUESTS_PER_MINUTE=20
